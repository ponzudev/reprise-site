---
// ランディングページ。見た目は src/styles/lp.css、無音デモの動きは src/scripts/demo.js。
import Head from '../components/Head.astro';
import Arrow from '../components/Arrow.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import FeatureScreenshot from '../components/FeatureScreenshot.astro';
import { featureScreens } from '../data/featureScreens';
import { site } from '../data/site';
import { faq } from '../data/faq';
import '../styles/lp.css';

const title = 'Reprise（リプライズ）｜好きな音声でリピーティング。一文ごとに聞いて、声に出す語学プレーヤー';
const description =
  'Podcast やレッスンの録音を一文ずつに自動分割。聞いた文のあとに声に出す間が入る、リピーティング用の語学プレーヤーです。毎回停止ボタンを押さずに、聞いて、まねる練習を続けられます。基本機能は無料、アカウント登録は不要。';
const store = site.appStoreUrl;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Reprise（リプライズ）',
    alternateName: ['Reprise', 'リプライズ'],
    url: site.url + '/',
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Reprise（リプライズ）',
    alternateName: 'Reprise',
    description,
    url: site.url + '/',
    image: site.url + '/assets/app-icon.png',
    screenshot: site.url + '/assets/04-player-playing.webp',
    operatingSystem: 'iOS 26.0 以降',
    applicationCategory: 'EducationalApplication',
    inLanguage: 'ja',
    installUrl: store,
    downloadUrl: store,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
    featureList: [
      '音声を端末内で文ごとに自動分割',
      '文ごとのリピート再生とリピーティング用のポーズ',
      '0.5〜2.0 倍の速度調整',
      '本文を伏せて聞く',
      'Podcast・録音・音声や動画のファイル・貼り付けた文章を教材にする',
      '学習時間の記録',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

const steps = [
  {
    title: '音声を取り込む',
    text: 'Podcast を検索するか、ファイル・録音・貼り付けた文章から。共有メニューからも送れます。',
  },
  {
    title: '自動で、文ごとに分かれる',
    text: 'iPhone の中で文字起こしをして、文の切れ目で区切ります。スクリプトの用意はいりません。',
  },
  {
    title: '一文ずつ、聞いて声に出す',
    text: '「文ごとに区切る」を選んで再生。音声のあとの間にまねると、次の文へ自動で進みます。',
  },
];

---
<!doctype html>
<html lang="ja">
<head>
<Head title={title} description={description} ogTitle="Reprise（リプライズ）— 一文聞いて、声に出す。" jsonLd={jsonLd} />
<meta name="theme-color" content="#ffffff">
<link rel="preload" as="image" href="/assets/phone-04-player-playing.webp" imagesrcset="/assets/phone-04-player-playing.webp 720w, /assets/phone-04-player-playing@2x.webp 1260w" imagesizes="(max-width: 700px) 228px, 300px" fetchpriority="high">
</head>
<body>
<a class="skip" href="#main">本文へスキップ</a>

<header class="header wrap">
  <a class="brand" href="/" aria-label="Reprise ホーム">
    <span class="brand-icon"><img src="/assets/app-icon-120.png" width="36" height="36" alt=""></span>Reprise<span class="brand-ja">リプライズ</span>
  </a>
  <nav aria-label="メインナビゲーション">
    <a href="#how">使い方</a>
    <a href="#materials">使える教材</a>
    <a href="#pricing">料金</a>
    <a href="#demo">体験する</a>
  </nav>
  <AppStoreBadge compact />
</header>

<main id="main">

<section class="hero wrap">
  <div class="hero-copy">
    <h1>
      <span class="hero-kicker"><span class="dot"></span>好きな音声で、リピーティング。</span>
      一文聞いて、<br><span class="mark">声に出す。</span>
    </h1>
    <p class="hero-description">
      一文を聞いて、同じ文をまねる「リピーティング」に。<br>Podcast や録音を自動で区切り、<strong>声に出す間まで用意。</strong>毎回、停止ボタンを押す必要はありません。
    </p>
    <div class="hero-actions">
      <AppStoreBadge />
      <a class="text-link" href="#demo">音なしで使い方を見る <span>↓</span></a>
    </div>
    <ul class="hero-points">
      <li>基本の練習は無料</li>
      <li>アカウント登録なし</li>
      <li>音声は端末の外に出ません</li>
    </ul>
    <p class="micro">{site.requirement}</p>
  </div>
  <div class="hero-visual">
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <span class="visual-label label-top">「ピッ」が、話し始める合図。</span>
    <div class="phone framed hero-phone">
      <img src="/assets/phone-04-player-playing.webp" srcset="/assets/phone-04-player-playing.webp 720w, /assets/phone-04-player-playing@2x.webp 1260w" sizes="(max-width: 700px) 228px, 300px" width="720" height="1472" alt="英会話の音声が 1 文ずつに分かれて並ぶ、Reprise の再生画面" fetchpriority="high">
    </div>
    <div class="float-card">
      <span class="mini-wave"><i></i><i></i><i></i><i></i><i></i></span>
      <span>聞く。まねる。もう一度。<small>聞いた文に合わせて、間が入る。</small></span>
      <span class="loop-symbol">↻</span>
    </div>
    <span class="visual-label label-bottom">聞く → 間にまねる → 次の一文へ</span>
  </div>
</section>

<aside class="specs-strip" aria-label="Reprise の基本仕様">
  <dl class="wrap specs-grid">
    <div><dt>再生速度</dt><dd><strong>0.5〜2.0</strong> 倍<small>音程を保って調整</small></dd></div>
    <div><dt>声に出すポーズ</dt><dd><strong>文の長さに連動</strong><small>合図音で、自分の番へ</small></dd></div>
    <div><dt>無料で保存</dt><dd><strong>教材 5 冊</strong>まで<small>文ごとの練習も無料</small></dd></div>
    <div><dt>文字起こし</dt><dd><strong>{site.languages.length} 言語</strong><small>英語は米・英・豪に対応</small></dd></div>
    <div><dt>取り込み元</dt><dd class="spec-sources">Podcast／ファイル<br>録音／文章<small>いつもの素材で練習</small></dd></div>
  </dl>
</aside>





<section class="section demo-section" id="demo">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">TRY REPRISE</p>
      <h2>「ピッ」が鳴ったら、<br>あなたの番。</h2>
      <p>お手本を聞く。合図でまねる。次の一文へ。<br>音を出さずに、練習の流れを見てみましょう。</p>
    </div>
    <div class="demo-layout">
      <div class="demo-guide">
        <span class="section-number">SILENT DEMO · 音は出ません</span>
        <h3>話し始めるタイミングに、<br>もう迷わない。</h3>
        <p>画面を見続けなくても、合図音で自分の番が分かります。<br>停止ボタンの操作は、アプリにおまかせ。</p>
        <ol class="demo-stages" aria-label="練習の流れを選ぶ">
          <li><button type="button" data-stage="listen" aria-pressed="true"><span>1</span><span><strong>一文、お手本を聞く</strong><small>音声を文の区切りまで再生。</small></span></button></li>
          <li><button type="button" data-stage="cue" aria-pressed="false"><span>2</span><span><strong>「ピッ」と、話す合図</strong><small>短いビープ音が、聞く・話すを切り替えます。</small></span></button></li>
          <li><button type="button" data-stage="speak" aria-pressed="false"><span>3</span><span><strong>空いた間に、声に出す</strong><small>聞いた文の長さに合わせた間のあと、次の文へ。</small></span></button></li>
        </ol>
        <p class="demo-note">音の出ない説明用モックです。合図音は「ピッ」の文字で表現しています。実際のアプリでは合図音をオフにすることもできます。</p>
        <noscript><p class="demo-note">一文を聞く → 合図音 → まねる時間 → 次の一文。この流れがアプリで自動で続きます。</p></noscript>
      </div>
      <div class="demo-device" data-phase="listen">
        <div class="device-screen">
          <div class="device-statusbar" aria-hidden="true">
            <span>9:41</span><span class="device-island"></span>
            <svg viewBox="0 0 60 16"><path d="M1 12h3v3H1zm5-4h3v7H6zm5-4h3v11h-3zm5-3h3v14h-3" fill="currentColor"/><path d="M25 5q7-7 14 0m-11 3q4-4 8 0m-5 3h2" fill="none" stroke="currentColor" stroke-width="2.5"/><rect x="44" y="3" width="13" height="10" rx="2" fill="none" stroke="currentColor"/><path d="M58 6v4" stroke="currentColor" stroke-width="2"/><rect x="46" y="5" width="9" height="6" rx="1" fill="currentColor"/></svg>
          </div>
      <div class="demo-player" aria-label="Reprise の音の出ない説明用モック">
        <div class="demo-top">
          <span class="mock-back" aria-hidden="true">‹</span>
          <div><strong>カフェでのひとこと</strong><small>3 文 · 練習の流れ</small></div>
          <span class="demo-badge">DEMO</span>
        </div>
        <div class="mock-track-info"><span>一文ずつ、聞いてまねる</span><span>全 3 文</span></div>
        <div class="sentences" id="sentences">
          {[
            ['Could I have a coffee, please?', 'コーヒーをいただけますか？'],
            ['I’ll have it here.', 'ここで飲みます。'],
            ['Thank you. Have a nice day!', 'ありがとう。よい一日を！'],
          ].map(([text, meta], i) => (
            <button class:list={['sentence', { active: i === 0 }]} data-index={i} aria-label={`${i + 1}文目で流れを見る`}>
              <span class="sentence-number">0{i + 1}</span>
              <span><span class="sentence-text">{text}</span><small>{meta}</small></span>
              <span class="sentence-play"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 12 7-12 7z" fill="currentColor"/></svg></span>
            </button>
          ))}
        </div>
        <div class="silent-phase" aria-hidden="true">
          <span class="phase-symbol" id="phase-symbol">♪</span>
          <strong id="phase-title">お手本を聞く</strong>
          <span id="phase-description">まずは、一文を最後まで。</span>
        </div>
        <div class="demo-status"><span class="status-dot"></span><span id="status" role="status" aria-live="polite">音なしで練習の流れを表示します</span></div>
        <div class="demo-controls">
          <div class="progress-track" role="progressbar" aria-label="説明の進み具合" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="progress"></span></div>
          <div class="mock-settings"><span>文ごとに区切る</span><span>音なしデモ</span></div>
          <div class="player-buttons">
            <button id="restart" type="button">最初から</button>
            <button id="previous" class="icon-button" aria-label="前の文の説明"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zm12 0v14L8 12z" fill="currentColor"/></svg></button>
            <button id="play" class="silent-play" aria-label="デモを開始">流れを見る</button>
            <button id="next" class="icon-button" aria-label="次の文の説明"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM6 5v14l10-7z" fill="currentColor"/></svg></button>
          </div>
        </div>
      </div>
          <div class="device-home" aria-hidden="true"></div>
        </div>
        <p class="device-caption">音なしで分かる、リピーティングの流れ</p>
      </div>
    </div>
  </div>
</section>





<section class="section wrap features-section" id="features">
  <div class="section-heading">
    <p class="eyebrow">MAKE IT YOURS</p>
    <h2>止める操作は、アプリに。<br>あなたは、聞いてまねるだけ。</h2>
    <p>リピーティングを続けやすくする、3 つの機能。</p>
  </div>
  <div class="feature-grid">
    <article class="feature">
      <span class="feature-icon">↻</span><span class="card-index">01</span>
      <h3>合図が鳴ったら、<br>声に出す。</h3>
      <p>一文のあとに「ピッ」と合図。聞いた文に合わせた間にまねるだけ。画面を見続けなくても、話し始めるタイミングが分かります。</p>
      <div class="cue-flow"><span>聞く</span><b>ピッ</b><span>声に出す</span></div>
    </article>
    <article class="feature">
      <span class="feature-icon">≋</span><span class="card-index">02</span>
      <h3>長い音声も、<br>一文ずつ。</h3>
      <p>端末内の音声認識で文字起こしをし、句読点などから「意味の切れ目」を見つけて分割します。</p>
      <div class="split-example" aria-label="区切り方の比較例">
        <p><strong>無音を境に切ると</strong><small>文の途中で切れることも</small><span lang="en">I’d like <b class="split-cut" aria-label="ここで分割">／</b> a coffee.</span></p>
        <p><strong>Reprise は文の切れ目で</strong><span class="whole-sentence" lang="en">I’d like a coffee.</span></p>
        <small>区切り方のイメージです。音声認識できない場合は無音で分割。本文や区切りは手直しできます。</small>
      </div>
    </article>
    <article class="feature">
      <span class="feature-icon">Aa</span><span class="card-index">03</span>
      <h3>文字を離れて、<br>耳と口で。</h3>
      <p>本文を隠して、音だけを頼りに練習。長押しで本文を表示して、すぐ答え合わせ。</p>
      <div class="blur-sample"><span>I'll keep that in mind.</span><small>文字を隠してリスニング</small></div>
    </article>
  </div>
  <p class="practice-links">練習方法を見る：<a href="/guides/repeating">リピーティングのやり方</a><a href="/guides/shadowing">音声を追いかける</a><a href="/guides">すべてのガイド →</a></p>
  <div class="privacy-note">
    <span>◈</span>
    <p><strong>あなたの教材は、あなたの端末に。</strong>文字起こしも文の分割も iPhone の中で行います。音声と学習記録をサーバーへ送ることはなく、アカウント登録もいりません。</p>
  </div>
</section>

<section class="section premium-features" id="premium-features" aria-labelledby="premium-features-title">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">REPRISE PREMIUM</p>
      <h2 id="premium-features-title">Premium で深まる練習。</h2>
      <p>自分の声を確かめる。気になる一文を、もう一度。</p>
    </div>
    <section class="feature-detail check-detail" id="speech-check" aria-labelledby="check-title">
      <div class="detail-copy">
        <span class="feature-plan">Premium · 伝わるかチェック</span>
        <h3 id="check-title">その発音、伝わった？</h3>
        <p class="detail-lead">自分では言えたつもりの一文。<br>音声認識にどう聞こえたか、語ごとに確かめられます。</p>
        <ol class="check-steps">
          <li><span>01</span><div><strong>文を長押しして、録音する</strong><p>「伝わるかチェック」を開き、お手本の文を自分の声で。</p></div></li>
          <li><span>02</span><div><strong>端末内で、書き起こす</strong><p>録音を iPhone の中で音声認識。音声は端末の外へ送りません。</p></div></li>
          <li><span>03</span><div><strong>お手本と、単語ごとに照合</strong><p>同じ語として聞き取られた箇所、別の語になった箇所、聞き取られなかった箇所を色などで表示します。</p></div></li>
        </ol>
        <p class="detail-note"><strong>発音の採点ではありません。</strong>お手本の語が音声認識にどう聞き取られたかを示します。お手本と自分の声を聴き比べることもできます。</p>
      </div>
      <FeatureScreenshot screen={featureScreens.check} />
    </section>
    <section class="feature-detail review-detail" id="review" aria-labelledby="review-title">
      <div class="detail-copy">
        <span class="feature-plan">Premium · 復習モード</span>
        <h3 id="review-title">気になる一文だけ、<br>まとめて復習。</h3>
        <p class="detail-lead">ブックマークした文が、教材をまたいで一か所に。<br>聞き直す場所を、毎回探す必要はありません。</p>
        <ul class="detail-list">
          <li>再生画面で文を右へスワイプしてブックマーク</li>
          <li>集めた文を、ポーズを挟んで一文ずつ練習</li>
          <li>難しい文は「1 文をループ」で繰り返す</li>
        </ul>
        <a class="detail-link" href="#pricing">Premium の料金を見る <Arrow /></a>
      </div>
      <FeatureScreenshot screen={featureScreens.review} />
    </section>
  </div>
</section>

<section class="section materials-section" id="materials">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">LEARN FROM YOUR EVERYDAY</p>
      <h2>練習したいのは、<br>いつもの音声。</h2>
      <p>Podcast・レッスン録音・手持ちのファイル。好きな素材で始められます。</p>
    </div>
    <div class="materials-layout">
      <div class="materials-photo">
        <span class="image-caption">お気に入りの番組で、毎日少しずつ。</span>
        <div class="phone framed material-phone"><img src="/assets/phone-13-podcast-picker.webp" srcset="/assets/phone-13-podcast-picker.webp 720w, /assets/phone-13-podcast-picker@2x.webp 1260w" sizes="(max-width: 700px) 245px, 280px" alt="Podcast の番組を探して教材に取り込む画面" loading="lazy" width="720" height="1472"></div>
        <span class="material-sticker">いつもの「好き」を<br>学びに変えよう。</span>
      </div>
      <div class="material-list">
        <article><span>01 / PODCAST</span><h3>いつも聞いている、あの番組。</h3><p>番組を検索して、気になるエピソードを取り込み。生きた言葉を、一文ずつ聞き直せます。<a href="/guides/podcast">Podcast で練習する方法</a></p></article>
        <article><span>02 / RECORDING</span><h3>レッスンの録音を、復習に。</h3><p>先生の言い回しや、会話のフレーズ。その場で録音するか、ボイスメモから送って、繰り返し練習。<a href="/guides/lesson-recording">レッスンの録音を復習する方法</a></p></article>
        <article><span>03 / TEXT</span><h3>読みかけの記事も、耳から。</h3><p>練習したい文章を貼り付けて音声に。好きな言語と声を選んで、自分だけの教材を作れます。</p></article>
        <article><span>04 / FILES</span><h3>手持ちの教材を、そのまま。</h3><p>教材に付いてきた音声や、動画ファイル、DRM のない音楽も。使い慣れた教材を、練習しやすい形に。</p></article>
      </div>
    </div>
    <div class="language-note">
      <strong>対応している言語</strong>
      <ul>{site.languages.map((language) => <li>{language}</li>)}</ul>
    </div>
  </div>
</section>





<section class="section wrap how-section" id="how">
  <div class="section-heading">
    <p class="eyebrow">HOW IT WORKS</p>
    <h2>音声を選んだら、練習へ。</h2>
    <p>台本を作ったり、リピート区間を指定したりする手間を減らします。</p>
  </div>
  <ol class="step-grid">
    {steps.map((step, i) => (
      <li class="step">
        <span class="step-number">STEP {i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<section class="section learning-log" id="learning-log" aria-labelledby="log-title">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">YOUR LEARNING LOG</p>
      <h2 id="log-title">続けた分だけ、見える。</h2>
      <p>今日どれだけ練習したか。どの教材に時間を使ったか。<br>カレンダーとグラフで、学習を振り返れます。</p>
    </div>
    <div class="log-layout">
      <div class="log-copy">
        <dl class="log-metrics">
          <div><dt>今日の学習時間</dt><dd>再生中と、声に出すためのポーズを記録。</dd></div>
          <div><dt>再生した文の数</dt><dd>一文を聞き終えるごとに加算。繰り返しも1回ずつ。</dd></div>
          <div><dt>習得した文</dt><dd>自分で「習得済み」にした文の数を確認。</dd></div>
          <div><dt>連続学習日数</dt><dd>1分以上練習した日が、何日続いたか。</dd></div>
          <div><dt>教材ごとの学習時間</dt><dd>選んだ期間に、何をどれだけ練習したか。</dd></div>
        </dl>
        <div class="log-periods">
          <p><strong>Free</strong><span>直近 7 日のグラフ・教材別の時間</span></p>
          <p><strong>Premium</strong><span>14 日・1 か月・3 か月・半年・1 年・全期間に切り替え</span></p>
        </div>
        <p class="detail-note">日ごとの詳細は直近 7 日分を表示。長い期間は、グラフや教材別の時間で振り返ります。</p>
      </div>
      <div class="log-screens">
        <FeatureScreenshot screen={featureScreens.today} />
        <FeatureScreenshot screen={featureScreens.log} />
      </div>
    </div>
  </div>
</section>

<section class="section pricing-section" id="pricing">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">START SMALL. KEEP GOING.</p>
      <h2>リピーティングを、無料で。</h2>
      <p>まずは Free で、自分の教材を使ってみてください。</p>
    </div>
    <div class="pricing-grid">
      <article class="price-card free-plan">
        <p class="plan-name">Free <span>まずは試してみたい方へ</span></p>
        <p class="price">¥0</p>
        <p class="price-sub">自分の教材で、練習をはじめる。</p>
        <ul>
          <li>文ごとの再生・リピート・速度調整</li>
          <li>教材を5冊まで保存</li>
          <li>文章から音声作成：月3本まで</li>
          <li>直近7日間の学習記録</li>
          <li>Podcast の手動取り込み</li>
        </ul>
        <AppStoreBadge />
      </article>
      <article class="price-card premium">
        <span class="premium-tag">もっと使いたくなったら</span>
        <p class="plan-name">Premium <span>毎日の練習を深めたい方へ</span></p>
        <p class="price">¥{site.price.monthly.toLocaleString('ja-JP')}<span> / 月</span></p>
        <p class="price-sub">または年額 ¥{site.price.yearly.toLocaleString('ja-JP')}（月あたり ¥{Math.round(site.price.yearly / 12).toLocaleString('ja-JP')}）</p>
        <ul>
          <li>Free のすべての基本機能</li>
          <li>教材数・文章からの音声作成の上限を解除</li>
          <li>長期間の学習記録を振り返り</li>
          <li>ブックマークした文の復習・伝わるかチェック</li>
          <li>Podcast の新着を自動で取り込み</li>
        </ul>
        <AppStoreBadge />
        <p class="trial-note">初めての方は7日間の無料体験</p>
      </article>
    </div>
    <p class="pricing-note">価格は日本の App Store のものです。無料体験の適用条件はアプリ内の購入画面をご確認ください。<br>Premium は自動更新の定期購読です。解約は App Store のサブスクリプション設定から行えます。購読をやめても、作った教材はすべて再生できます。</p>
  </div>
</section>

<section class="section wrap faq-section" id="faq">
  <div class="section-heading">
    <p class="eyebrow">FAQ</p>
    <h2>よくある質問</h2>
  </div>
  <div class="faq-list">
    {faq.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
  <p class="faq-more">使い方の詳しい説明は<a href="/support">サポート</a>に、練習のしかたは<a href="/guides">練習ガイド</a>にまとめています。</p>
</section>

<section class="closing wrap">
  <span class="brand-icon large"><img src="/assets/app-icon-120.png" width="58" height="58" alt="Reprise のアプリアイコン"></span>
  <p class="eyebrow">今日の一文から。</p>
  <h2>好きな音声で、<br>リピーティングを。</h2>
  <AppStoreBadge />
  <p class="micro">{site.requirement} · アカウント登録なし</p>
  <div class="qr">
    <img src="/assets/appstore-qr.svg" width="96" height="96" alt="App Store の Reprise のページを開く QR コード" loading="lazy">
    <p>パソコンでご覧の方は、<br>iPhone のカメラで読み取ってください。</p>
  </div>
</section>

</main>

<footer class="footer wrap">
  <a class="brand" href="/">Reprise</a>
  <div>
    <a href="/guides">練習ガイド</a>
    <a href="/support">サポート</a>
    <a href="/privacy">プライバシーポリシー</a>
  </div>
  <small>© Reprise</small>
</footer>


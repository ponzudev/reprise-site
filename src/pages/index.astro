---
// ランディングページ。見た目は src/styles/lp.css、体験版プレーヤーの動きは src/scripts/demo.js。
import Head from '../components/Head.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { faq } from '../data/faq';
import '../styles/lp.css';

const title = 'Reprise（リプライズ）｜音声を文ごとに自動分割する、シャドーイング・リピーティング用の語学プレーヤー';
const description =
  'Podcast やレッスンの録音、手持ちの音声ファイルを iPhone の中で 1 文ずつに自動分割。聞き取れなかった一文にタップで戻り、リピーティングやシャドーイングを練習できる語学プレーヤーです。基本機能は無料、アカウント登録は不要。';
const store = site.appStoreUrl;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Reprise（リプライズ）',
    alternateName: ['Reprise', 'リプライズ'],
    url: site.url + '/',
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Reprise（リプライズ）',
    alternateName: 'Reprise',
    description,
    url: site.url + '/',
    image: site.url + '/assets/app-icon.png',
    screenshot: site.url + '/assets/04-player-playing.webp',
    operatingSystem: 'iOS 26.0 以降',
    applicationCategory: 'EducationalApplication',
    inLanguage: 'ja',
    installUrl: store,
    downloadUrl: store,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
    featureList: [
      '音声を端末内で文ごとに自動分割',
      '文ごとのリピート再生とリピーティング用のポーズ',
      '0.5〜2.0 倍の速度調整',
      '本文を伏せて聞く',
      'Podcast・録音・音声や動画のファイル・貼り付けた文章を教材にする',
      '学習時間の記録',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

const problems = [
  {
    title: '聞き取れなかった一文に、戻れない。',
    text: 'シークバーを少しずつ動かして、行きすぎて、また戻して。聞き直したい場所を探しているうちに、集中が切れてしまう。',
  },
  {
    title: '好きな音声には、スクリプトがない。',
    text: '練習したいのは、いつもの Podcast やレッスンの録音。でも、文字と区切りがそろっているのは専用の教材だけ。',
  },
  {
    title: '聞き流すだけで、終わってしまう。',
    text: '声に出す練習がいいと分かっていても、止めて、まねて、また再生して、の操作が続かない。',
  },
];

const gallery = [
  {
    src: '/assets/store-1-split.webp',
    alt: '外国語を、文ごとに自動で分割。英語の物語が 1 文ずつに分かれて並び、再生中の文が明るく表示されている画面',
  },
  {
    src: '/assets/store-2-podcast.webp',
    alt: 'Podcast が、そのまま教材に。動画ファイル、レッスン録音、会議音声、音楽ファイルも。取り込んだ Podcast が教材として並ぶ画面',
  },
  {
    src: '/assets/store-3-check.webp',
    alt: '自分の発音を、お手本と聴き比べ。録音した文が語ごとに色分けされ、お手本と自分の声を続けて聞ける画面',
  },
];

const screens = [
  {
    src: '/assets/phone-11-player-text-hidden.webp',
    alt: '本文をぼかして伏せた再生画面。文の番号と長さだけが見えている',
    title: '本文を伏せて、耳だけで',
    text: 'ボタンを押さえている間だけ本文が出ます。',
  },
  {
    src: '/assets/phone-06-sentence-editor.webp',
    alt: '波形を見ながら文の頭と終わりを動かす「文の調整」の画面',
    title: '区切りも本文も、手直しできる',
    text: '波形を見ながら、文の頭と終わりを指で動かせます。',
  },
  {
    src: '/assets/phone-14-podcast-episodes.webp',
    alt: 'Podcast のエピソード一覧から、取り込む回を選んでいる画面',
    title: '聞きたい回だけ、選んで取り込む',
    text: '番組ごとに 1 冊の教材にまとまります。',
  },
  {
    src: '/assets/phone-08-study-log-graph.webp',
    alt: '日ごとの学習時間の棒グラフと、教材ごとの学習時間が並ぶ画面',
    title: '続けた時間が、グラフで見える',
    text: '日ごと・教材ごとの学習時間を振り返れます。',
  },
];

const steps = [
  {
    title: '音声を取り込む',
    text: 'Podcast を検索するか、ファイル・録音・貼り付けた文章から。共有メニューからも送れます。',
  },
  {
    title: '自動で、文ごとに分かれる',
    text: 'iPhone の中で文字起こしをして、文の切れ目で区切ります。スクリプトの用意はいりません。',
  },
  {
    title: '一文ずつ、聞いて声に出す',
    text: '文をタップして聞き直し、ポーズの間にまねる。速度もリピートも、指ひとつで。',
  },
];

const practices = [
  {
    name: 'リピーティング',
    how: '一文を聞いたあと、止まっている間に同じ文を声に出す練習。',
    reprise: '「文ごとに区切る」で、1 文ごとに合図音と、聞いた文と同じ長さの間が自動で入ります。',
    href: '/guides/repeating',
  },
  {
    name: 'シャドーイング',
    how: '音声を止めずに、少し遅れて影のように追いかけて声に出す練習。',
    reprise: '「通しで再生」か「1 文をループ」で。難しい文は 0.5 倍まで、音程を保ったまま遅くできます。',
    href: '/guides/shadowing',
  },
  {
    name: 'オーバーラッピング',
    how: '本文を見ながら、音声とぴったり重ねて声に出す練習。',
    reprise: '文字起こしがそのまま台本に。いま鳴っている文が明るくなるので、目で追いやすい。',
    href: '/guides/overlapping',
  },
  {
    name: 'ディクテーション',
    how: '聞こえた文を、そのまま書き取る練習。',
    reprise: '本文を伏せて 1 文をループ。ボタンを長押ししている間だけ本文が出て、すぐ答え合わせ。',
    href: '/guides/dictation',
  },
];

const compare = [
  ['聞き直したい文に戻る', 'シークバーや 15 秒戻しで探す', '文をタップ、または「前の文」'],
  ['区間のリピート', 'A 点と B 点を、その都度自分で決める', '文ごとに自動。設定はいりません'],
  ['声に出すための間', '自分で一時停止する', '聞いた文と同じ長さの間を自動で'],
  ['文字（スクリプト）', '付いていない音声が多い', '端末内の文字起こしで、どの音声にも'],
  ['練習の記録', '残らない', '学習時間と、文ごとの再生回数'],
];
---
<!doctype html>
<html lang="ja">
<head>
<Head title={title} description={description} ogTitle="Reprise（リプライズ）— 聞いて、声に出して、身につける" jsonLd={jsonLd} />
<meta name="theme-color" content="#ffffff">
<link rel="preload" as="image" href="/assets/phone-04-player-playing.webp" fetchpriority="high">
</head>
<body>
<a class="skip" href="#main">本文へスキップ</a>

<header class="header wrap">
  <a class="brand" href="/" aria-label="Reprise ホーム">
    <span class="brand-icon"><img src="/assets/app-icon-120.png" width="36" height="36" alt=""></span>Reprise<span class="brand-ja">リプライズ</span>
  </a>
  <nav aria-label="メインナビゲーション">
    <a href="#how">使い方</a>
    <a href="#features">特徴</a>
    <a href="#materials">使える教材</a>
    <a href="#pricing">料金</a>
    <a href="#faq">よくある質問</a>
  </nav>
  <a class="button small" href={store}>無料ではじめる <span><Arrow /></span></a>
</header>

<main id="main">

<section class="hero wrap">
  <div class="hero-copy">
    <h1>
      <span class="hero-kicker"><span class="dot"></span>文ごとに区切れる、シャドーイング用の語学プレーヤー</span>
      聞いて、<br>声に出して、<br><span class="mark">身につける</span><span class="period">。</span>
    </h1>
    <p class="hero-description">
      Podcast も、レッスンの録音も、手持ちの音声ファイルも。<br>
      取り込んだ音声を iPhone の中で<strong>1 文ずつに自動で分ける</strong>から、聞き取れなかった一文に、タップひとつで戻れます。
    </p>
    <div class="hero-actions">
      <a class="button" href={store}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.1 12.4c0-2 1.6-3 1.7-3.1-1-1.5-2.6-1.7-3.2-1.7-1.4-.2-2.7.8-3.4.8-.7 0-1.8-.8-2.9-.8C7.8 7.6 6.4 8.5 5.6 10c-1.6 2.8-.4 6.9 1.1 9.1.7 1.1 1.6 2.2 2.8 2.1 1.1 0 1.5-.7 2.9-.7s1.8.7 3 .7 2-1 2.7-2c.8-1.2 1.2-2.3 1.2-2.4-.1 0-2.2-.9-2.2-3.4v-1zM14.9 6.2c.6-.8 1.1-1.8 1-2.9-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.8-1 2.8 1.1.1 2.2-.5 2.9-1.4z"/></svg>
        <span><small>無料でダウンロード</small>App Store</span>
        <span class="arrow"><Arrow /></span>
      </a>
      <a class="text-link" href="#demo">まずは触ってみる <span>↓</span></a>
    </div>
    <ul class="hero-points">
      <li>基本の練習は無料</li>
      <li>アカウント登録なし</li>
      <li>音声は端末の外に出ません</li>
    </ul>
    <p class="micro">{site.requirement}</p>
  </div>
  <div class="hero-visual">
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <span class="visual-label label-top">好きな一文を、何度でも。</span>
    <div class="phone framed hero-phone">
      <img src="/assets/phone-04-player-playing.webp" width="720" height="1472" alt="英会話の音声が 1 文ずつに分かれて並ぶ、Reprise の再生画面" fetchpriority="high">
    </div>
    <div class="float-card">
      <span class="mini-wave"><i></i><i></i><i></i><i></i><i></i></span>
      <span>聞く。まねる。もう一度。<small>自分のペースで、ひとつずつ。</small></span>
      <span class="loop-symbol">↻</span>
    </div>
    <span class="visual-label label-bottom">YOUR EVERYDAY, REPLAYED.</span>
  </div>
</section>

<div class="intro-strip"><span>好きな音声で。</span><span>好きなペースで。</span><span>何度でも。</span></div>

<section class="section wrap problems-section" id="why">
  <div class="section-heading">
    <p class="eyebrow">WHY REPRISE</p>
    <h2>音声で練習するとき、<br>こんなこと、ありませんか。</h2>
  </div>
  <div class="problem-grid">
    {problems.map((item) => (
      <article class="problem">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ))}
  </div>
  <p class="problem-answer">
    Reprise は、どんな音声も<strong>文ごとに区切って</strong>、<br class="desktop-break">
    「聞く → 声に出す → もう一度」を、操作なしで続けられるようにします。
  </p>
</section>

<section class="gallery-section" aria-label="Reprise の画面">
  <ul class="gallery">
    {gallery.map((item) => (
      <li><img src={item.src} alt={item.alt} width="660" height="1434" loading="lazy"></li>
    ))}
  </ul>
</section>

<section class="section demo-section" id="demo">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">TRY REPRISE</p>
      <h2>まずは、一文。<br>触って、聞いてみて。</h2>
      <p>文をタップすると、そこから再生。<br>繰り返す心地よさを、この場で体験できます。</p>
    </div>
    <div class="demo-layout">
      <div class="demo-guide">
        <span class="section-number">INTERACTIVE DEMO</span>
        <h3>戻したいのは、<br>「あの一文」。</h3>
        <p>再生位置を探す手間を減らして、<br>聞くこと、話すことに集中。</p>
        <ol>
          <li><span>1</span><div><strong>聞きたい文をタップ</strong><p>文の頭から、ぴったり再生。</p></div></li>
          <li><span>2</span><div><strong>リピートで、もう一度</strong><p>声に出すための間を挟んで繰り返し。</p></div></li>
          <li><span>3</span><div><strong>慣れたら、本文を隠す</strong><p>耳で聞いた音を頼りに、声に出して。</p></div></li>
        </ol>
        <p class="demo-note">♫ 音が出ます。アプリに入っている日本語の案内音声を使った体験版です。アプリでは、英語などあなたの音声で同じことができます。</p>
      </div>
      <div class="demo-player" aria-label="操作できる音声プレーヤー">
        <div class="demo-top">
          <span class="demo-app-icon"><img src="/assets/app-icon-120.png" width="38" height="38" alt=""></span>
          <div><strong>Reprise へようこそ</strong><small>3 文 · アプリの使い方</small></div>
          <span class="demo-badge">DEMO</span>
        </div>
        <div class="demo-status"><span class="status-dot"></span><span id="status" role="status" aria-live="polite">聞きたい文をタップしてください</span></div>
        <div class="sentences" id="sentences">
          {[
            ['リプライズへようこそ。', '0:00 · 2.2 秒'],
            ['リプライズは、語学の音声を、文ごとにくり返して聞くためのプレーヤーです。', '0:02 · 6.1 秒'],
            ['音声を取り込むと、この端末の中で、自動で文ごとに分けます。', '0:08 · 5.5 秒'],
          ].map(([text, meta], i) => (
            <button class:list={['sentence', { active: i === 0 }]} data-index={i} aria-label={`${i + 1}文目を再生`}>
              <span class="sentence-number">0{i + 1}</span>
              <span><span class="sentence-text">{text}</span><small>{meta}</small></span>
              <span class="sentence-play"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 12 7-12 7z" fill="currentColor"/></svg></span>
            </button>
          ))}
        </div>
        <div class="demo-controls">
          <div class="progress-track" role="progressbar" aria-label="文の再生位置" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="progress"></span></div>
          <div class="player-buttons">
            <button id="hide-text" aria-pressed="false">本文を隠す</button>
            <button id="previous" class="icon-button" aria-label="前の文"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zm12 0v14L8 12z" fill="currentColor"/></svg></button>
            <button id="play" class="play-button" aria-label="再生"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 12 7-12 7z" fill="currentColor"/></svg></button>
            <button id="next" class="icon-button" aria-label="次の文"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM6 5v14l10-7z" fill="currentColor"/></svg></button>
            <button id="speed" aria-label="再生速度 1倍">1.0×</button>
          </div>
          <button id="loop" class="loop-button" aria-pressed="false">↻ <span>リピート OFF</span></button>
        </div>
        <audio id="audio" preload="metadata" src="/assets/demo.m4a"></audio>
      </div>
    </div>
  </div>
</section>

<section class="section wrap how-section" id="how">
  <div class="section-heading">
    <p class="eyebrow">HOW IT WORKS</p>
    <h2>使い方は、3 ステップ。</h2>
    <p>むずかしい設定はありません。<br>取り込んだら、あとは聞いて、声に出すだけ。</p>
  </div>
  <ol class="step-grid">
    {steps.map((step, i) => (
      <li class="step">
        <span class="step-number">STEP {i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<section class="section practice-section" id="practice">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">FOR EVERY PRACTICE</p>
      <h2>やりたい練習に、<br>そのまま使える。</h2>
      <p>シャドーイングも、リピーティングも。<br>同じ音声で、練習のしかたを切り替えられます。</p>
    </div>
    <div class="practice-grid">
      {practices.map((item) => (
        <article class="practice">
          <h3>{item.name}</h3>
          <p class="practice-how">{item.how}</p>
          <p class="practice-reprise"><span>Reprise では</span>{item.reprise}</p>
          <a href={item.href}>{item.name}のやり方を見る <Arrow /></a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section wrap features-section" id="features">
  <div class="section-heading">
    <p class="eyebrow">MAKE IT YOURS</p>
    <h2>聞き流す時間を、<br>身につける時間に。</h2>
    <p>聞く、繰り返す、声に出す。<br>その小さな練習を、もっとスムーズに。</p>
  </div>
  <div class="feature-grid">
    <article class="feature">
      <span class="feature-icon">≋</span><span class="card-index">01</span>
      <h3>長い音声も、<br>一文ずつ。</h3>
      <p>取り込んだ音声を、無音ではなく文の切れ目で自動分割。聞き取れなかったところに、ワンタップで戻れます。ずれた区切りは、長押しで手直しできます。</p>
      <div class="mini-sentences"><span>It's finally getting warmer, isn't it?</span><span class="selected">Have you been to this cafe before? <b>↻</b></span><span>Their lemon cake is worth trying.</span></div>
    </article>
    <article class="feature">
      <span class="feature-icon">↻</span><span class="card-index">02</span>
      <h3>声に出すための、<br>ちょうどいい間。</h3>
      <p>一文を聞いたら、合図音のあとの間にまねして発話。間の長さは、聞いた文に合わせて自動で決まります。速度は 0.5〜2.0 倍、音程はそのまま。</p>
      <div class="sound-flow"><span>聞く <b>▂▅▇▃▆▂</b></span><i>→</i><span>声に出す <b>▂▃▆▇▅▂</b></span></div>
    </article>
    <article class="feature">
      <span class="feature-icon">Aa</span><span class="card-index">03</span>
      <h3>文字を離れて、<br>耳と口で。</h3>
      <p>本文を伏せて、聞こえた音を頼りに練習。ボタンを押さえている間だけ本文が出るので、答え合わせもすぐ。</p>
      <div class="blur-sample"><span>I'll keep that in mind.</span><small>文字を隠してリスニング</small></div>
    </article>
  </div>
  <div class="privacy-note">
    <span>◈</span>
    <p><strong>あなたの教材は、あなたの端末に。</strong>文字起こしも文の分割も iPhone の中で行います。音声と学習記録をサーバーへ送ることはなく、アカウント登録もいりません。</p>
  </div>
</section>

<section class="screens-section" aria-label="アプリの画面">
  <ul class="screens">
    {screens.map((item) => (
      <li>
        <img src={item.src} alt={item.alt} width="720" height="1472" loading="lazy">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </li>
    ))}
  </ul>
</section>

<section class="section materials-section" id="materials">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">LEARN FROM YOUR EVERYDAY</p>
      <h2>身の回りに、<br>教材はあふれている。</h2>
      <p>「これを聞けるようになりたい」。<br>その気持ちが、学びの入り口。</p>
    </div>
    <div class="materials-layout">
      <div class="materials-photo">
        <span class="image-caption">お気に入りの番組で、毎日少しずつ。</span>
        <div class="phone framed material-phone"><img src="/assets/phone-13-podcast-picker.webp" alt="Podcast の番組を探して教材に取り込む画面" loading="lazy" width="720" height="1472"></div>
        <span class="material-sticker">いつもの「好き」を<br>学びに変えよう。</span>
      </div>
      <div class="material-list">
        <article><span>01 / PODCAST</span><h3>いつも聞いている、あの番組。</h3><p>番組を検索して、気になるエピソードを取り込み。生きた言葉を、一文ずつ聞き直せます。<a href="/guides/podcast">Podcast で練習する方法</a></p></article>
        <article><span>02 / RECORDING</span><h3>レッスンの録音を、復習に。</h3><p>先生の言い回しや、会話のフレーズ。その場で録音するか、ボイスメモから送って、繰り返し練習。<a href="/guides/lesson-recording">レッスンの録音を復習する方法</a></p></article>
        <article><span>03 / TEXT</span><h3>読みかけの記事も、耳から。</h3><p>練習したい文章を貼り付けて音声に。好きな言語と声を選んで、自分だけの教材を作れます。</p></article>
        <article><span>04 / FILES</span><h3>手持ちの教材を、そのまま。</h3><p>教材に付いてきた音声や、動画ファイル、DRM のない音楽も。使い慣れた教材を、練習しやすい形に。</p></article>
      </div>
    </div>
    <div class="language-note">
      <strong>対応している言語</strong>
      <ul>{site.languages.map((language) => <li>{language}</li>)}</ul>
    </div>
  </div>
</section>

<section class="section wrap compare-section" id="compare">
  <div class="section-heading">
    <p class="eyebrow">WHAT'S DIFFERENT</p>
    <h2>ふつうのプレーヤーと、<br>どこが違う？</h2>
    <p>音楽アプリや Podcast アプリは、通して聞くための道具。<br>Reprise は、一文ずつ練習するための道具です。</p>
  </div>
  <div class="compare-scroll">
    <table class="compare-table">
      <thead><tr><th scope="col"></th><th scope="col">音楽・Podcast アプリ</th><th scope="col" class="ours">Reprise</th></tr></thead>
      <tbody>
        {compare.map(([label, other, ours]) => (
          <tr><th scope="row">{label}</th><td>{other}</td><td class="ours">{ours}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section class="section wrap habits-section" id="habits">
  <div class="habits-copy">
    <p class="eyebrow">A LITTLE, EVERY DAY</p>
    <h2>小さな「できた」が、<br>明日につながる。</h2>
    <p>今日の5分も、昨日の一文も。<br>積み重ねを見える形にして、続ける力に。</p>
    <div class="habit"><span>▦</span><div><h3>学んだ時間が、残る。</h3><p>カレンダーとグラフで、毎日の学習時間と連続日数を振り返れます。</p></div></div>
    <div class="habit"><span>⚑</span><div><h3>気になる一文を、もう一度。</h3><p>ブックマークした文を、すべての教材から集めて復習。苦手な表現を、少しずつ自分のものに。</p><small>Premium</small></div></div>
    <div class="habit"><span>♫</span><div><h3>自分の声が、伝わるか確かめる。</h3><p>文を読んで録音すると、端末内の音声認識にどう聞き取られたかを語ごとに表示。お手本と自分の声の聴き比べもできます。</p><small>Premium</small></div></div>
  </div>
  <div class="habits-visual">
    <div class="phone framed study-phone"><img src="/assets/phone-07-study-log.webp" loading="lazy" alt="学習した日と学習時間を確認できるカレンダー画面" width="720" height="1472"></div>
    <div class="habit-label">続けた分だけ、<br><strong>自分の言葉に。</strong><span><Arrow /></span></div>
  </div>
</section>

<section class="section pricing-section" id="pricing">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">START SMALL. KEEP GOING.</p>
      <h2>まずは、無料で。<br>もっと続けたくなったら。</h2>
      <p>文ごとの再生も、リピートも。<br>練習の基本は、無料ではじめられます。</p>
    </div>
    <div class="pricing-grid">
      <article class="price-card">
        <p class="plan-name">Free <span>まずは試してみたい方へ</span></p>
        <p class="price">¥0</p>
        <p class="price-sub">自分の教材で、練習をはじめる。</p>
        <ul>
          <li>文ごとの再生・リピート・速度調整</li>
          <li>教材を5冊まで保存</li>
          <li>文章から音声作成：月3本まで</li>
          <li>直近7日間の学習記録</li>
          <li>Podcast の手動取り込み</li>
        </ul>
        <a class="button secondary" href={store}>無料ではじめる <span><Arrow /></span></a>
      </article>
      <article class="price-card premium">
        <span class="premium-tag">学びを、もっと自由に。</span>
        <p class="plan-name">Premium <span>毎日の練習を深めたい方へ</span></p>
        <p class="price">¥{site.price.monthly.toLocaleString('ja-JP')}<span> / 月</span></p>
        <p class="price-sub">または年額 ¥{site.price.yearly.toLocaleString('ja-JP')}（月あたり ¥{Math.round(site.price.yearly / 12).toLocaleString('ja-JP')}）</p>
        <ul>
          <li>Free のすべての基本機能</li>
          <li>教材数・文章からの音声作成の上限を解除</li>
          <li>長期間の学習記録を振り返り</li>
          <li>ブックマークした文の復習・伝わるかチェック</li>
          <li>Podcast の新着を自動で取り込み</li>
        </ul>
        <a class="button" href={store}>アプリで Premium を見る <span><Arrow /></span></a>
        <p class="trial-note">初めての方は7日間の無料体験</p>
      </article>
    </div>
    <p class="pricing-note">価格は日本の App Store のものです。無料体験の適用条件はアプリ内の購入画面をご確認ください。<br>Premium は自動更新の定期購読です。解約は App Store のサブスクリプション設定から行えます。購読をやめても、作った教材はすべて再生できます。</p>
  </div>
</section>

<section class="section wrap faq-section" id="faq">
  <div class="section-heading">
    <p class="eyebrow">FAQ</p>
    <h2>よくある質問</h2>
  </div>
  <div class="faq-list">
    {faq.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
  <p class="faq-more">使い方の詳しい説明は<a href="/support">サポート</a>に、練習のしかたは<a href="/guides">練習ガイド</a>にまとめています。</p>
</section>

<section class="closing wrap">
  <span class="brand-icon large"><img src="/assets/app-icon-120.png" width="58" height="58" alt="Reprise のアプリアイコン"></span>
  <p class="eyebrow">今日の一文から。</p>
  <h2>聞いて、声に出して、<br>身につける。</h2>
  <a class="button" href={store}>App Store で無料ダウンロード <span><Arrow /></span></a>
  <p class="micro">{site.requirement} · アカウント登録なし</p>
  <div class="qr">
    <img src="/assets/appstore-qr.svg" width="96" height="96" alt="App Store の Reprise のページを開く QR コード" loading="lazy">
    <p>パソコンでご覧の方は、<br>iPhone のカメラで読み取ってください。</p>
  </div>
</section>

</main>

<footer class="footer wrap">
  <a class="brand" href="/">Reprise</a>
  <div>
    <a href="/guides">練習ガイド</a>
    <a href="/support">サポート</a>
    <a href="/privacy">プライバシーポリシー</a>
  </div>
  <small>© Reprise</small>
</footer>

<div class="mobile-cta">
  <span>いつもの音声を、教材に。</span>
  <a class="button small" href={store}>無料ではじめる <Arrow /></a>
</div>


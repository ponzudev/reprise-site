---
// App Store のバッジ。言語ごとに Apple のバッジ（public/assets/app-store-badge-<言語>.svg）を出し、
// リンクにはその言語のストアと、どこから来たかの印（campaign）を付ける。
import { appStoreCampaignUrl } from '../data/site';
import { strings, type Lang } from '../data/i18n';
interface Props { compact?: boolean; lang?: 'ja' | Lang; campaign?: string }
const { compact = false, lang = 'ja', campaign = `site-${lang}` } = Astro.props;
const label = lang === 'ja' ? 'App Store で Reprise をダウンロード' : strings[lang].badgeLabel;
// バッジの横幅は言語で違う（高さ 40 のときの幅。縦横比を変えない）。
const width = { ja: 109, en: 120, ko: 130, 'zh-hans': 109, 'zh-hant': 109 }[lang];
const alt = lang === 'ja' ? 'App Store からダウンロード' : strings[lang].badgeAlt;
---
<a class:list={['app-store-badge', { compact }]} href={appStoreCampaignUrl(campaign, lang)} aria-label={label}>
  <img src={`/assets/app-store-badge-${lang}.svg`} width={width} height="40" alt={alt} />
</a>
<style>
  .app-store-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 13px;
    line-height: 0;
    border-radius: 0;
    background: transparent;
  }
  .app-store-badge img { display: block; width: auto; height: 52px; border-radius: 0; }
  .app-store-badge.compact { padding: 10px; }
  .app-store-badge.compact img { height: 40px; }
  .app-store-badge:focus-visible { outline: 3px solid #087ff5; outline-offset: 2px; }
</style>

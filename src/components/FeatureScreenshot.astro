---
interface Props {
  screen: { id: string; src: string | null; alt: string; label: string; width?: number; height?: number; scroll?: boolean };
}
const { screen } = Astro.props;
---
<figure class="feature-screenshot" data-image-slot={screen.id}>
  {screen.src ? (
    <div class:list={['screenshot-window', { scrollable: screen.scroll }]} tabindex={screen.scroll ? 0 : undefined} role={screen.scroll ? 'region' : undefined} aria-label={screen.scroll ? `${screen.label}（画像内をスクロールできます）` : undefined}>
      <img src={screen.src} alt={screen.alt} width={screen.width ?? 660} height={screen.height ?? 1434} loading="lazy" />
    </div>
  ) : (
    <div class="screenshot-placeholder">
      <span aria-hidden="true">▧</span>
      <strong>{screen.label}</strong>
      <p>実機スクリーンショット準備中</p>
    </div>
  )}
  <figcaption>{screen.src ? screen.label : '画面は後日掲載予定です。'}
    {screen.src && <><br />{screen.scroll && <span>画像内をスクロールできます · </span>}<a href={screen.src} target="_blank" rel="noopener" aria-label={`${screen.label}を新しいタブで拡大`}>拡大して見る</a></>}
  </figcaption>
</figure>
<style>
  .feature-screenshot { margin: 0 auto; width: min(100%, 280px); }
  /* 白い画面が白い背景に溶け込まないよう、端末の縁のような濃い枠で囲む。 */
  .screenshot-window { border-radius: 30px; border: 5px solid #1b2634; overflow: hidden; box-shadow: 0 0 0 1.5px #c3cedb, 0 18px 42px #164f9526; background: #1b2634; }
  .screenshot-window.scrollable { max-height: 620px; overflow-y: auto; }
  .screenshot-window:focus-visible { outline: 3px solid #087ff5; outline-offset: 4px; }
  img { display: block; width: 100%; height: auto; }
  .screenshot-placeholder { min-height: 380px; display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 28px; border: 1px dashed #93abc5; border-radius: 24px; background: #f4f8fc; text-align: center; color: #4b6480; }
  .screenshot-placeholder > span { font-size: 40px; color: #7f9aba; }
  strong { font-size: 16px; line-height: 1.8; }
  p, figcaption { font-size: 12px; line-height: 1.8; }
  p { margin: 0; }
  figcaption { margin-top: 16px; text-align: center; color: #607089; }
  figcaption a { color: #0759c6; text-decoration: underline; text-underline-offset: 3px; }
</style>

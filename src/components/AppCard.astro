---
// 文書ページの終わりに置く、アプリの案内。
import AppStoreBadge from './AppStoreBadge.astro';
import { docStrings, type DocLang } from '../data/docs';
interface Props { lang?: DocLang }
const { lang = 'ja' } = Astro.props;
---
<aside class="app-card">
  <img src="/assets/app-icon-120.png" width="56" height="56" alt="">
  <div>
    <strong>{lang === 'ja' ? 'Reprise（リプライズ）' : 'Reprise'}</strong>
    <span>{docStrings[lang].appCard}</span>
  </div>
  <AppStoreBadge lang={lang} />
</aside>

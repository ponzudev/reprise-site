---
// プライバシーポリシー・サポート・練習ガイドなど、Markdown で書く文書ページの共通レイアウト。
import Head from '../components/Head.astro';
import { site } from '../data/site';

const { frontmatter = {}, title: titleProp, description: descriptionProp, fullTitle, ogType, noindex, jsonLd } = Astro.props;
const title = titleProp ?? frontmatter.title;
const description =
  descriptionProp ??
  frontmatter.description ??
  'Reprise（リプライズ）は、音声を文ごとに区切って繰り返し聞ける、シャドーイング・リピーティング用の語学プレーヤーです。';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const nav = [
  { href: '/guides', label: '練習ガイド' },
  { href: '/support', label: 'サポート' },
  { href: '/privacy', label: 'プライバシー' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang="ja">
<head>
  <Head title={fullTitle ?? `${title}｜Reprise（リプライズ）`} description={description} ogType={ogType} noindex={noindex} jsonLd={jsonLd} />
  <style is:global>
    :root {
      --bg: #f7f7f9;
      --card: #ffffff;
      --text: #1c1c1e;
      --muted: #6e6e73;
      --line: #e5e5ea;
      --accent: #2f6fed;
      --accent-soft: #e8f0ff;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f0f12;
        --card: #1a1a1f;
        --text: #f2f2f7;
        --muted: #9a9aa3;
        --line: #2c2c33;
        --accent: #6ea1ff;
        --accent-soft: #1b2a47;
      }
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Helvetica Neue", "Segoe UI", sans-serif;
      font-size: 17px;
      line-height: 1.75;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }

    header.site {
      position: sticky; top: 0; z-index: 10;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: saturate(180%) blur(16px);
      -webkit-backdrop-filter: saturate(180%) blur(16px);
      border-bottom: 1px solid var(--line);
    }
    header.site .wrap {
      display: flex; align-items: center; gap: 12px;
      height: 60px;
    }
    header.site img {
      width: 32px; height: 32px; border-radius: 8px;
      box-shadow: 0 1px 3px rgba(0,0,0,.15);
    }
    header.site .brand {
      display: flex; align-items: center; gap: 12px;
      font-weight: 700; font-size: 17px; letter-spacing: .01em; color: var(--text);
    }
    header.site .brand:hover { text-decoration: none; }
    header.site .brand, header.site nav a { white-space: nowrap; }
    @media (max-width: 520px) {
      header.site .wrap { flex-wrap: wrap; height: auto; min-height: 60px; padding-block: 10px; gap: 6px 12px; }
      header.site .brand small { display: none; }
      header.site nav a { padding: 6px 9px; font-size: 13px; }
    }
    header.site .brand small {
      font-weight: 500; color: var(--muted); margin-left: 6px; font-size: 13px;
    }
    header.site nav { margin-left: auto; display: flex; gap: 4px; }
    header.site nav a {
      padding: 6px 12px; border-radius: 999px;
      color: var(--muted); font-size: 14px; font-weight: 500;
    }
    header.site nav a:hover { text-decoration: none; background: var(--accent-soft); color: var(--accent); }
    header.site nav a.current { background: var(--accent-soft); color: var(--accent); }

    main.page {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 36px 32px;
      margin: 32px auto;
    }
    @media (max-width: 600px) {
      main.page { padding: 24px 20px; border-radius: 16px; margin: 20px auto; }
      body { font-size: 16px; }
    }

    main h1 { font-size: 1.6rem; line-height: 1.3; margin: 0 0 .25em; letter-spacing: -.01em; }
    main h1 + p { color: var(--muted); font-size: .95rem; margin-top: 0; }
    main h2 {
      font-size: 1.15rem; margin: 2.2em 0 .6em;
      padding-bottom: .3em; border-bottom: 1px solid var(--line);
    }
    main h3 { font-size: 1rem; margin: 1.6em 0 .4em; }
    main p, main ul, main ol { margin: .6em 0; }
    main li { margin: .2em 0; }
    main strong { font-weight: 700; }
    main hr {
      border: 0; height: 1px; background: var(--line); margin: 3em 0;
    }
    main table {
      width: 100%; border-collapse: collapse; font-size: .95rem; margin: 1em 0;
    }
    main th, main td {
      text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line);
      vertical-align: top;
    }
    main th { color: var(--muted); font-weight: 600; font-size: .85rem; }
    main code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: .9em; background: var(--bg); padding: .1em .4em; border-radius: 6px;
    }

    footer.site {
      color: var(--muted); font-size: 13px; line-height: 2;
      padding: 8px 20px 48px; text-align: center;
    }

    .breadcrumb { font-size: 13px; color: var(--muted); margin: 0 0 1.2em; }
    .breadcrumb a { color: var(--muted); }
    main .lead { color: var(--muted); font-size: 1rem; }
    .app-card {
      display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
      background: var(--accent-soft); border-radius: 16px;
      padding: 20px 22px; margin: 2.6em 0 0;
    }
    .app-card > img { width: 56px; height: 56px; border-radius: 13px; }
    .app-card div { flex: 1 1 240px; }
    .app-card strong { display: block; font-size: 1rem; }
    .app-card span { display: block; font-size: .88rem; color: var(--muted); line-height: 1.6; }
    .guide-list { list-style: none; padding: 0; margin: 1.4em 0 0; }
    .guide-list li { border-top: 1px solid var(--line); margin: 0; }
    .guide-list a { display: block; padding: 16px 2px; color: var(--text); }
    .guide-list a:hover { text-decoration: none; }
    .guide-list a:hover strong { color: var(--accent); }
    .guide-list strong { display: block; }
    .guide-list span { display: block; font-size: .9rem; color: var(--muted); line-height: 1.7; }

    footer.site a { margin: 0 6px; }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/"><img src="/assets/app-icon-120.png" width="32" height="32" alt=""><span>Reprise<small>リプライズ</small></span></a>
      <nav aria-label="メインナビゲーション">
        {nav.map((item) => (
          <a href={item.href} class={isCurrent(item.href) ? 'current' : undefined} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <div class="wrap">
    <main class="page">
      <slot name="before" />
      <slot />
      <slot name="after" />
    </main>
  </div>

  <footer class="site">
    Reprise — 文ごとに区切れる語学プレーヤー<br>
    <a href="/">トップ</a><a href="/guides">練習ガイド</a><a href="/support">サポート</a><a href="/privacy">プライバシーポリシー</a><a href={site.appStoreUrl}>App Store</a><br>
    <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
  </footer>
</body>
</html>
